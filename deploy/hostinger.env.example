APP_NAME="School Online Repository"
APP_ENV=production
# Copy the EXISTING APP_KEY when migrating the database; do not regenerate it.
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=Asia/Manila
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=HOSTINGER_DATABASE_NAME
DB_USERNAME=HOSTINGER_DATABASE_USERNAME
DB_PASSWORD="REPLACE_WITH_DATABASE_PASSWORD"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=school_repository_premium_v5_session
SESSION_DOMAIN=null
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# The system uses in-app notifications. Configure SMTP separately if email is needed.
MAIL_MAILER=log
AI_PROVIDER=groq
AI_AUTO_EVALUATE=false
AI_MAX_CHARS=50000
# Keep the existing encrypted database setting, or set a key here privately.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=120
VITE_APP_NAME="${APP_NAME}"
